# ITSM AI Agent Environment Configuration
# Copy this file to .env and fill in your Azure credentials

# API Configuration
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=your-super-secret-key-here

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-openai-key-here
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# Azure Cosmos DB Configuration
COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-key-here
COSMOS_DATABASE_NAME=itsm_agent
COSMOS_CONVERSATIONS_CONTAINER=conversations
COSMOS_USERS_CONTAINER=users
COSMOS_AGENTS_CONTAINER=agents
COSMOS_TICKETS_CONTAINER=tickets

# Azure Computer Vision Configuration
COMPUTER_VISION_ENDPOINT=https://your-vision-resource.cognitiveservices.azure.com/
COMPUTER_VISION_KEY=your-vision-key-here

# Azure Text Analytics Configuration
TEXT_ANALYTICS_ENDPOINT=https://your-textanalytics-resource.cognitiveservices.azure.com/
TEXT_ANALYTICS_KEY=your-textanalytics-key-here

# Azure Storage Configuration
STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=yourstorageaccount;AccountKey=your-storage-key;EndpointSuffix=core.windows.net
STORAGE_CONTAINER_NAME=agent-files

# Bot Framework Configuration
MICROSOFT_APP_ID=your-bot-app-id-here
MICROSOFT_APP_PASSWORD=your-bot-app-password-here

# Teams Configuration
TEAMS_APP_ID=your-teams-app-id-here
TEAMS_TENANT_ID=your-tenant-id-here
